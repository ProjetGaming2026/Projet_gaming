MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 270083719}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 498b1ad1bf1d430987c1daa915079e95, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PatientPuzzleController
  openingDialogue:
  - speaker: 0
    line: Who are you? What happened here?
    tone: 0
    playCoughDuringLine: 0
  - speaker: 1
    line: Lower your voice... it listens through the vents.
    tone: 3
    playCoughDuringLine: 0
  - speaker: 0
    line: What is listening?
    tone: 0
    playCoughDuringLine: 0
  - speaker: 1
    line: They opened me yesterday... and put something back inside that was still
      breathing.
    tone: 3
    playCoughDuringLine: 1
  - speaker: 1
    line: Do not look under the bed. If you see it, pretend you did not.
    tone: 3
    playCoughDuringLine: 0
  requests:
  - requiredItemId: blanket
    requestLine: I am so cold... my hands are going numb...
    repeatRequestLine: I can't keep talking until I am covered
    successLine: Yes... keep it on me. Now I can still talk.
    placementPoint: {fileID: 0}
    placementLocalPosition: {x: 0, y: 0, z: 0}
    placementLocalEulerAngles: {x: 0, y: 0, z: 0}
    placementLocalScale: {x: 1, y: 1, z: 1}
    visualAfterUse: {fileID: 1840047926}
    useVisualAfterUseInsteadOfMovingItem: 1
    playCoughAfterSuccess: 1
  - requiredItemId: oxygen
    requestLine: I still cannot breathe...help me .
    repeatRequestLine: I need oxygen
    successLine: Yes... air... I remember the code now.
    placementPoint: {fileID: 0}
    placementLocalPosition: {x: 0, y: 0, z: 0}
    placementLocalEulerAngles: {x: 0, y: 0, z: 0}
    placementLocalScale: {x: 1, y: 1, z: 1}
    visualAfterUse: {fileID: 1749867794}
    useVisualAfterUseInsteadOfMovingItem: 1
    playCoughAfterSuccess: 0
  finalLine: The code... 0417. Leave before it comes back.
  solvedRepeatLine: The code is 0417... leave me alone. She will kill both of us.
  countAsSolvedTask: 1
  onPuzzleSolved:
    m_PersistentCalls:
      m_Calls: []
  messageDuration: 4
  patientDialogueWaitsForNextInteraction: 1
  firstInteractionCough: {fileID: 8300000, guid: 43ea056387da1c344809fa5153a99dca, type: 3}
  firstInteractionCoughVolume: 1
  requestCough: {fileID: 0}
  requestCoughVolume: 1
  enableDialogueCoughMarkers: 1
  dialogueCoughDelay: 1.1
