  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DocumentPickup
  interactDistance: 2.5
  interactKey: 101
  lookAngle: 18
  documentText: "PATIENT REPORT - Room 304\nDr. Elara Voss \u2014 Deceased, October
    14, 1987\n\nBody found incomplete.\n\nMissing organs, in order of removal :\n\n
    1. The Heart \u2014 taken first, while still beating.\n   2. The Hand \u2014
    her right hand, the one that wrote.\n   3. The Liver \u2014 removed last, in
    the dark.\n\nFind my organs and put theme on the trays next to my corpse so I
    can rest in peace."
  bloodTexture: {fileID: 2800000, guid: 7f022ef8f44ba3443b3f98e7cf17001a, type: 3}
  paperTexture: {fileID: 0}
  promptText: Press E to read
  helpMeSound: {fileID: 8300000, guid: a46693399bfe6e24e9ea24b0d1b2b065, type: 3}
  helpMeVolume: 1
